{
    "name": "Streamlit App",
    "image": "mcr.microsoft.com/devcontainers/python:3.12-trixie",
    "runArgs": ["--name", "docker-python-devcontainer"],

    // This makes sure your libraries are installed automatically inside the container
    "postCreateCommand": "pip3 install -r requirements.txt",

    // This allows your Mac's browser to see the Streamlit app
    "forwardPorts": [8501],

    "customizations": {
        "vscode": {
            // This ensures the Python extension is ready inside the container
            "extensions": ["ms-python.python"]
        }
    }
}